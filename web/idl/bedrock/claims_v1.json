      "docs": [
        "Vault natywnego XNT bez pol poza dyskryminatorem - PDA nalezace do TEGO",
        "programu (seeds: [\"staking_reward_vault\"] / [\"treasury_vault\"] / [\"pol_treasury\"]).",
